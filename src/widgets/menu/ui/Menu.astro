---
import MenuInteractive from '~/widgets/menu/ui/MenuInteractive'
---

<section class="relative w-full">
  <div class="mb-6 sm:mb-8">
    <span class="text-xs font-medium uppercase tracking-wider text-neutral-400 sm:text-sm">
      Nuestro menú
    </span>

    <h2 class="mt-2 text-2xl font-bold leading-tight text-white sm:text-3xl md:text-4xl">
      Elige tus favoritos
    </h2>

    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-neutral-400 sm:text-base">
      Explora nuestro menú y agrega tus productos favoritos al pedido.
    </p>
  </div>

  <MenuInteractive client:load />
</section>
